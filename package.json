{
  "name": "biryeong",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "check": "node --test tests/*.test.mjs systems/vault/tests/c01/*.test.mjs",
    "rebuild:data": "node systems/data/build-catalogs.mjs",
    "vault": "node systems/vault/cli.mjs",
    "vault:build": "node systems/vault/build.mjs",
    "vault:verify": "node systems/vault/cli.mjs verify",
    "check:vault-c01": "node --test systems/vault/tests/c01/*.test.mjs",
    "site:data": "node systems/site-data/build.mjs",
    "play:build": "node systems/play/build.mjs",
    "build": "node systems/site-data/build.mjs && node systems/play/build.mjs"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  }
}
